# ─── App ──────────────────────────────────────────────────────────────
# Public origin the browser uses to reach the app (no trailing slash).
APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aether:aether_dev_password@localhost:54329/aether

# ─── Object storage (Amazon S3) ───────────────────────────────────────
# For Amazon S3: set region + bucket + IAM keys and leave S3_ENDPOINT empty.
# For local development with docker compose (RustFS), use the values below.
S3_REGION=us-east-1
S3_BUCKET=aether-files
S3_ACCESS_KEY_ID=aether_local
S3_SECRET_ACCESS_KEY=aether_local_dev_secret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ─── Limits ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
USER_QUOTA_MB=1024
